[Unit]
Description=woni 관측 스택 동기화 (배포된 revision → monitoring 구성)
Documentation=https://github.com/leejungkuk/multi_currency_household_ledger/blob/main/tools/monitoring-sync.sh
After=docker.service
Requires=docker.service
OnFailure=woni-deploy-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
# 배포 에이전트와 state.json whole-file RMW 및 compose 실행을 직렬화하는 공용 StateDirectory다.
StateDirectory=woni-deploy
# 유닛이 $HOME에 의존하지 않도록 설정 파일과 실행 파일 모두 절대경로로 명시한다.
Environment=WONI_AGENT_CONF=/home/ubuntu/woni/deploy/agent.conf
ExecStart=/home/ubuntu/woni/repo/tools/monitoring-sync.sh
# 자체 🚨는 "복원 실패·관측 스택 down", OnFailure 🔴는 "스크립트 비정상 종료·스택 상태 미확인"이다.
# 단계별 상한 합은 1740초다. 정착 관찰 60초는 측정값이 아니라 수용한 운영 가정이며,
# systemd가 복원 도중 셸을 죽이지 않도록 전체 상한에 여유를 둔다.
TimeoutStartSec=2400
