[Unit]
Description=woni 관측 스택 동기화 주기 실행 (300초)
OnFailure=woni-deploy-alert@%n.service

[Timer]
# 설치·부팅 직후에는 이전 비활성 타임스탬프가 없으므로 첫 실행과 이후 주기를 모두 명시한다.
OnBootSec=2min
OnUnitInactiveSec=300
# woni-deploy.timer 와 위상이 겹치는 것을 막는다. 두 타이머는 주기·OnBootSec 이 같고 무변화 주기에는
# 둘 다 1초 안에 끝나므로, 같은 부팅에서 함께 켜지면 이후 **영구히 같은 초에 발화**한다. 그러면 공용 락
# (STATE_DIR/agent.lock)을 배포 쪽이 먼저 잡고 이쪽은 매 주기 `flock -n` 에 실패해 "배포 또는 관측
# 동기화가 진행 중이라 이번 주기를 건너뜁니다" 로 끝난다 — 실패가 아니라 정상 종료라 알림도 없고
# `synced_tree` 만 조용히 뒤처진다(2026-08-27 운영 실측: 승격된 grafana 13.2.0 이 반영되지 않고
# 13.1.3 에 멈춰 있었다). 지터는 매 발화마다 다시 뽑히므로 한쪽이 영구히 굶는 상태가 성립하지 않는다.
# 배포 타이머가 아니라 이쪽에 거는 이유: 배포 폴링 주기 300초는 문서·플랜에 명시된 값이고, 겹침을
# 푸는 데는 두 타이머 중 하나만 흔들리면 충분하다. 이쪽에는 그런 주기 계약이 없다.
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
