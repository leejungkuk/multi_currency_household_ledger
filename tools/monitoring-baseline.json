    "monitoring/prometheus/targets-deploy/woni-api.json": "679a32efd401724882732660dbdc60b146097ec2152517230c61d888bc3d9752",
    "monitoring/prometheus/targets/woni-api.json": "20f155c78a22f5a57d62ba0e49b929a27ff3488c824dda0ba493f73d53a1c9d7"
  },
  "services": [
    "alloy",
