{
  "compose": {
    "monitoring/docker-compose.deploy.yml": {
      "services": {
        "prometheus": {
          "networks": [
            "monitoring",
            "woni"
          ],
          "volumes": [
            "./prometheus/targets-deploy:/etc/prometheus/targets:ro"
          ]
        }
      }
    },
    "monitoring/docker-compose.yml": {
      "name": "woni-monitoring",
      "networks": {
        "monitoring": {
          "name": "woni-monitoring"
        }
      },
      "services": {
        "alloy": {
          "command": [
            "run",
            "--server.http.listen-addr=0.0.0.0:12345",
            "--storage.path=/var/lib/alloy/data",
            "/etc/alloy/config.alloy"
          ],
          "container_name": "woni-alloy",
          "depends_on": [
            "loki",
            "docker-socket-proxy"
          ],
          "image": "grafana/alloy:v1.19.2",
          "logging": {
            "driver": "json-file",
            "options": {
              "max-file": "3",
              "max-size": "10m"
            }
          },
          "networks": [
            "monitoring"
          ],
          "restart": "unless-stopped",
          "volumes": [
            "./alloy/config.alloy:/etc/alloy/config.alloy:ro",
            "alloy-data:/var/lib/alloy/data"
          ]
        },
        "docker-socket-proxy": {
          "container_name": "woni-docker-socket-proxy",
          "environment": {
            "CONTAINERS": 1,
            "NETWORKS": 1,
            "POST": 0
          },
          "image": "tecnativa/docker-socket-proxy:v0.5.0",
          "logging": {
            "driver": "json-file",
            "options": {
              "max-file": "3",
              "max-size": "10m"
            }
          },
          "networks": [
            "monitoring"
          ],
          "restart": "unless-stopped",
          "volumes": [
            "/var/run/docker.sock:/var/run/docker.sock:ro"
          ]
        },
        "grafana": {
          "container_name": "woni-grafana",
          "depends_on": [
            "prometheus",
            "loki"
          ],
          "environment": {
            "GF_ANALYTICS_CHECK_FOR_UPDATES": "false",
            "GF_ANALYTICS_REPORTING_ENABLED": "false",
            "GF_NEWS_NEWS_FEED_ENABLED": "false",
            "GF_SECURITY_ADMIN_PASSWORD": "${GRAFANA_ADMIN_PASSWORD:?monitoring/.env 에 GRAFANA_ADMIN_PASSWORD 를 설정하세요}",
            "GF_SECURITY_ADMIN_USER": "${GRAFANA_ADMIN_USER:-admin}",
            "GF_USERS_ALLOW_SIGN_UP": "false",
            "WONI_NTFY_TOPIC": "${WONI_NTFY_TOPIC:?monitoring/.env 에 WONI_NTFY_TOPIC 을 설정하세요}"
          },
          "image": "grafana/grafana:13.2.2",
          "logging": {
            "driver": "json-file",
            "options": {
              "max-file": "3",
              "max-size": "10m"
            }
          },
          "networks": [
            "monitoring"
          ],
          "ports": [
            "127.0.0.1:3000:3000"
          ],
          "restart": "unless-stopped",
          "volumes": [
            "./grafana/provisioning:/etc/grafana/provisioning:ro",
            "./grafana/dashboards:/var/lib/grafana/dashboards:ro",
            "grafana-data:/var/lib/grafana"
          ]
        },
        "loki": {
          "command": "-config.file=/etc/loki/loki-config.yml",
          "container_name": "woni-loki",
          "image": "grafana/loki:3.7.8",
          "logging": {
            "driver": "json-file",
            "options": {
              "max-file": "3",
              "max-size": "10m"
            }
          },
          "networks": [
            "monitoring"
          ],
          "restart": "unless-stopped",
          "volumes": [
            "./loki/loki-config.yml:/etc/loki/loki-config.yml:ro",
            "loki-data:/loki"
          ]
        },
        "node-exporter": {
          "command": [
            "--path.rootfs=/host",
            "--collector.textfile.directory=/host/var/lib/woni-metrics"
          ],
          "container_name": "woni-node-exporter",
          "image": "prom/node-exporter:v1.12.1",
          "logging": {
            "driver": "json-file",
            "options": {
              "max-file": "3",
              "max-size": "10m"
            }
          },
          "networks": [
            "monitoring"
          ],
          "pid": "host",
          "restart": "unless-stopped",
          "volumes": [
            "/:/host:ro"
          ]
        },
        "prometheus": {
          "command": [
            "--config.file=/etc/prometheus/prometheus.yml",
            "--storage.tsdb.path=/prometheus",
            "--storage.tsdb.retention.time=15d",
            "--storage.tsdb.retention.size=2GB",
            "--web.enable-lifecycle"
          ],
          "container_name": "woni-prometheus",
          "extra_hosts": [
            "host.docker.internal:host-gateway"
          ],
          "image": "prom/prometheus:v3.14.0",
          "logging": {
            "driver": "json-file",
            "options": {
              "max-file": "3",
              "max-size": "10m"
            }
          },
          "networks": [
            "monitoring"
          ],
          "ports": [
            "127.0.0.1:9090:9090"
          ],
          "restart": "unless-stopped",
          "volumes": [
            "./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro",
            "./prometheus/targets:/etc/prometheus/targets:ro",
            "prometheus-data:/prometheus"
          ]
        }
      },
      "volumes": {
        "alloy-data": {
          "name": "woni-alloy-data"
        },
        "grafana-data": {
          "name": "woni-grafana-data"
        },
        "loki-data": {
          "name": "woni-loki-data"
        },
        "prometheus-data": {
          "name": "woni-prometheus-data"
        }
      },
      "x-logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      }
    }
  },
  "files": {
